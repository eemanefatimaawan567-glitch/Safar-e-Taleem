# Safar-e-Taleem — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to git.

# Flask session signing secret (generate one: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" only for local development; keep "false" in production
FLASK_DEBUG=true

# Alibaba Cloud DashScope key — powers the Qwen "Ask Ammi/Abba" AI.
# Get one at https://dashscope.console.aliyun.com/
# When unset, the app gracefully falls back to rule-based responses.
DASHSCOPE_API_KEY=

# Optional: override the DashScope endpoint (default shown)
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Injected automatically by Render/Railway/Heroku — do not set locally
# PORT=5001
