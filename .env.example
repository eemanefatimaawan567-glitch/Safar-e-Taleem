# Safar-e-Taleem — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to git.

# Flask session signing secret (generate one: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" only for local development; keep "false" in production
FLASK_DEBUG=true

# Alibaba Cloud DashScope key — powers the Qwen "Ask Ammi/Abba" AI.
# Get one at https://dashscope.console.aliyun.com/
# When unset, the app gracefully falls back to rule-based responses.
DASHSCOPE_API_KEY=

# Optional: override the DashScope endpoint (default shown)
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Notification providers (ALL OPTIONAL) ------------------------------
# Without these the app runs in simulation mode: every WhatsApp/SMS/IVR
# send is logged as delivered so the demo always works with zero setup.

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Pakistani HTTP SMS gateway (SMS4Connect / Jazz / Telenor style endpoint)
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SENDER=SafarTaleem

# --- Optional tuning -----------------------------------------------------
# Production database (defaults to local SQLite: instance/database.db)
# DATABASE_URL=postgresql://user:pass@host:5432/safar_e_taleem

# Seconds an SSE location stream stays open before the browser reconnects
# SSE_CYCLE_SECONDS=50

# Set to 1 to disable API rate limiting (tests / local demos only)
# RATE_LIMIT_DISABLED=1

# Injected automatically by Render/Railway/Heroku — do not set locally
# PORT=5001
